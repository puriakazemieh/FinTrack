CREATE TABLE IF NOT EXISTS category (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    type INTEGER NOT NULL,
    colorId INTEGER NOT NULL DEFAULT 1,
    iconId INTEGER NOT NULL DEFAULT 1
);

-- Queries
addCategory:
INSERT INTO category(name, description, type, colorId, iconId)
VALUES (?, ?, ?, ?, ?);

insertAllCategory:
INSERT INTO category(name, description, type, colorId, iconId)
VALUES ?;

updateCategory:
UPDATE category
SET name = ?, description = ?, type = ?, colorId = ?, iconId = ?
WHERE id = ?;

observeCategories:
SELECT * FROM category WHERE type = ?;

getFirstByType:
SELECT * FROM category WHERE type = ? ORDER BY id LIMIT 1;

getTransferCategoryOrNull:
SELECT * FROM category WHERE type = 3 ORDER BY id LIMIT 1;

createTransferCategory:
INSERT INTO category(name, type)
VALUES ('انتقال', 3);

lastInsertRowId:
SELECT last_insert_rowid();

getCategoryById:
SELECT * FROM category WHERE id = ?;

-- اضافه کردن کتگوری انتقال اگر وجود نداشت
insertTransferCategoryIfMissing:
INSERT OR IGNORE INTO category (name, type, colorId, iconId, description)
VALUES ('انتقال', 3, 1, 1, NULL);

-- کوئری برای observeCategorySums
observeCategorySumsByFilter:
SELECT
    c.id AS categoryId,
    c.name AS name,
    SUM(t.amount) AS totalAmount,
    c.type AS type,
    c.colorId AS colorId,
    c.iconId AS iconId
FROM transactions t
INNER JOIN category c ON t.categoryId = c.id
WHERE
    (:type IS NULL OR t.type = :type)
    AND (:categoryIdsSize = 0 OR t.categoryId IN :categoryIds)
    AND (:sourceIdsSize = 0 OR t.sourceId IN :sourceIds)
    AND (:tagIdsSize = 0 OR EXISTS (
        SELECT 1 FROM transaction_tag WHERE transactionId = t.id AND tagId IN :tagIds
    ))
    AND (:personIdsSize = 0 OR EXISTS (
        SELECT 1 FROM transaction_person WHERE transactionId = t.id AND personId IN :personIds
    ))
    AND (:fromTimestamp IS NULL OR t.timeStamp >= :fromTimestamp)
    AND (:toTimestamp IS NULL OR t.timeStamp < :toTimestamp)
GROUP BY c.id, c.name, c.type, c.colorId, c.iconId;

deleteCategory:
DELETE FROM category WHERE id = ?;

insertFullCategory:
INSERT OR REPLACE INTO category(id, name, description, type, colorId, iconId)
VALUES (?, ?, ?, ?, ?, ?);

getMostUsedCategories:
SELECT c.* FROM category c
JOIN transactions t ON c.id = t.categoryId
WHERE (:type IS NULL OR c.type = :type)
GROUP BY c.id
ORDER BY COUNT(t.id) DESC
LIMIT :limit;
