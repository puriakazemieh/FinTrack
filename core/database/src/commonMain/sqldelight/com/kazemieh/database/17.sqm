CREATE TABLE IF NOT EXISTS goal_template (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    systemType TEXT NOT NULL DEFAULT 'SAVINGS',
    iconId INTEGER NOT NULL DEFAULT 1,
    colorId INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS goal_basket (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    iconId INTEGER NOT NULL DEFAULT 1,
    colorId INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

ALTER TABLE goal ADD COLUMN templateId INTEGER REFERENCES goal_template(id);
ALTER TABLE goal ADD COLUMN basketId INTEGER REFERENCES goal_basket(id);
