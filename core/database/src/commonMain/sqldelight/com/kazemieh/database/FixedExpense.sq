CREATE TABLE IF NOT EXISTS fixed_expense (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL DEFAULT '',
    amount INTEGER NOT NULL,
    categoryId INTEGER NOT NULL,
    sourceId INTEGER NOT NULL,
    description TEXT,
    recurrence TEXT NOT NULL,
    startDate INTEGER NOT NULL,
    nextDueDate INTEGER NOT NULL,
    endDate INTEGER,
    isAutoPostEnabled INTEGER NOT NULL DEFAULT 0,
    isActive INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (categoryId) REFERENCES category(id) ON DELETE CASCADE,
    FOREIGN KEY (sourceId) REFERENCES source(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_fixed_expense_category ON fixed_expense(categoryId);
CREATE INDEX IF NOT EXISTS idx_fixed_expense_source ON fixed_expense(sourceId);

insertFixedExpense:
INSERT INTO fixed_expense(title, amount, categoryId, sourceId, description, recurrence, startDate, nextDueDate, endDate, isAutoPostEnabled, isActive, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFixedExpense:
UPDATE fixed_expense
SET title = ?, amount = ?, categoryId = ?, sourceId = ?, description = ?, recurrence = ?, startDate = ?, nextDueDate = ?, endDate = ?, isAutoPostEnabled = ?, isActive = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

deleteFixedExpense:
UPDATE fixed_expense SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteFixedExpense:
DELETE FROM fixed_expense WHERE id = ?;

getFixedExpenseById:
SELECT * FROM fixed_expense WHERE id = ? AND syncStatus != 2;

observeAllFixedExpenses:
SELECT
    f.*,
    c.name AS categoryName,
    s.name AS sourceName,
    GROUP_CONCAT(DISTINCT fet.tagId) AS tagIds,
    GROUP_CONCAT(DISTINCT tag.name) AS tagNames,
    GROUP_CONCAT(DISTINCT fep.personId) AS personIds,
    GROUP_CONCAT(DISTINCT person.name) AS personNames
FROM fixed_expense f
LEFT JOIN category c ON f.categoryId = c.id
LEFT JOIN source s ON f.sourceId = s.id
LEFT JOIN fixed_expense_tag fet ON f.id = fet.fixedExpenseId
LEFT JOIN tag ON fet.tagId = tag.id
LEFT JOIN fixed_expense_person fep ON f.id = fep.fixedExpenseId
LEFT JOIN person ON fep.personId = person.id
WHERE f.syncStatus != 2
GROUP BY f.id
ORDER BY f.nextDueDate ASC;

observeFixedExpensesFiltered:
SELECT
    f.*,
    c.name AS categoryName,
    s.name AS sourceName,
    GROUP_CONCAT(DISTINCT fet.tagId) AS tagIds,
    GROUP_CONCAT(DISTINCT tag.name) AS tagNames,
    GROUP_CONCAT(DISTINCT fep.personId) AS personIds,
    GROUP_CONCAT(DISTINCT person.name) AS personNames
FROM fixed_expense f
LEFT JOIN category c ON f.categoryId = c.id
LEFT JOIN source s ON f.sourceId = s.id
LEFT JOIN fixed_expense_tag fet ON f.id = fet.fixedExpenseId
LEFT JOIN tag ON fet.tagId = tag.id
LEFT JOIN fixed_expense_person fep ON f.id = fep.fixedExpenseId
LEFT JOIN person ON fep.personId = person.id
WHERE f.syncStatus != 2
AND (:query IS NULL OR f.title LIKE ('%' || :query || '%') OR f.description LIKE ('%' || :query || '%'))
AND (:categoryIdsSize = 0 OR f.categoryId IN :categoryIds)
AND (:sourceIdsSize = 0 OR f.sourceId IN :sourceIds)
AND (:tagIdsSize = 0 OR EXISTS (SELECT 1 FROM fixed_expense_tag WHERE fixedExpenseId = f.id AND tagId IN :tagIds))
AND (:personIdsSize = 0 OR EXISTS (SELECT 1 FROM fixed_expense_person WHERE fixedExpenseId = f.id AND personId IN :personIds))
GROUP BY f.id
ORDER BY f.nextDueDate ASC;

updateNextDueDate:
UPDATE fixed_expense SET nextDueDate = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullFixedExpense:
INSERT OR REPLACE INTO fixed_expense(id, title, amount, categoryId, sourceId, description, recurrence, startDate, nextDueDate, endDate, isAutoPostEnabled, isActive, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedFixedExpenses:
SELECT * FROM fixed_expense WHERE syncStatus = 1;

markFixedExpenseAsSynced:
UPDATE fixed_expense SET syncStatus = 0 WHERE id = ?;
