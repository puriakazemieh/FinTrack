CREATE TABLE fixed_expense_posting (
    operationId TEXT NOT NULL PRIMARY KEY CHECK (length(trim(operationId)) > 0),
    expenseId INTEGER NOT NULL CHECK (expenseId > 0),
    periodDueDate INTEGER NOT NULL,
    transactionId INTEGER NOT NULL CHECK (transactionId > 0),
    postedAt INTEGER NOT NULL,
    isRepeat INTEGER NOT NULL DEFAULT 0 CHECK (isRepeat IN (0, 1))
);

-- Receipts outlive template/transaction deletion and parent REPLACE during restore.
-- New receipts validate their expense inside the owning database transaction.

-- A period has one ordinary posting; further postings require explicit repeat receipts.
CREATE UNIQUE INDEX fixed_expense_posting_primary ON fixed_expense_posting(expenseId, periodDueDate) WHERE isRepeat = 0;
CREATE INDEX fixed_expense_posting_expense ON fixed_expense_posting(expenseId, periodDueDate);

getPostingByOperationId:
SELECT * FROM fixed_expense_posting WHERE operationId = ?;

getPostingsForExpense:
SELECT * FROM fixed_expense_posting WHERE expenseId = ? ORDER BY periodDueDate DESC, postedAt DESC, operationId;

observeAllPostings:
SELECT * FROM fixed_expense_posting ORDER BY postedAt, operationId;

insertPosting:
INSERT INTO fixed_expense_posting(operationId, expenseId, periodDueDate, transactionId, postedAt, isRepeat)
VALUES (?, ?, ?, ?, ?, ?);
