CREATE TABLE IF NOT EXISTS transaction_tag (
    transactionId INTEGER NOT NULL,
    tagId INTEGER NOT NULL,
    PRIMARY KEY (transactionId, tagId),
    FOREIGN KEY (transactionId) REFERENCES transactions(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId) REFERENCES tag(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS  idx_transaction_tag_transaction ON transaction_tag(transactionId);
CREATE INDEX IF NOT EXISTS  idx_transaction_tag_tag ON transaction_tag(tagId);

insertTransactionTagCrossRefs:
INSERT OR IGNORE INTO transaction_tag(transactionId, tagId)
VALUES (?, ?);

deleteAllTagRefsForTransaction:
DELETE FROM transaction_tag WHERE transactionId = ?;

copyTagRefs:
INSERT OR IGNORE INTO transaction_tag(transactionId, tagId)
SELECT transactionId, :toTagId
FROM transaction_tag
WHERE tagId = :fromTagId;

deleteTagRefs:
DELETE FROM transaction_tag WHERE tagId = ?;

getTagsForTransaction:
SELECT t.* FROM tag t
INNER JOIN transaction_tag tt ON t.id = tt.tagId
WHERE tt.transactionId = ?;

lastInsertRowId:
SELECT last_insert_rowid();
