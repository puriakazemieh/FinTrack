CREATE TABLE IF NOT EXISTS tag (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    colorId INTEGER NOT NULL DEFAULT 1,
    iconId INTEGER NOT NULL DEFAULT 1,
    position INTEGER NOT NULL DEFAULT 0
);

addTag:
INSERT INTO tag(name, description, colorId, iconId, position)
VALUES (?, ?, ?, ?, ?);

insertAllTag:
INSERT INTO tag(name, description, colorId, iconId, position)
VALUES ?;

observeTags:
SELECT * FROM tag ORDER BY position ASC;

getTagById:
SELECT * FROM tag WHERE id = ?;

deleteTag:
DELETE FROM tag WHERE id = ?;

updateTag:
UPDATE tag
SET name = ?, description = ?, colorId = ?, iconId = ?, position = ?
WHERE id = ?;

updateTagPosition:
UPDATE tag SET position = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullTag:
INSERT OR REPLACE INTO tag(id, name, description, colorId, iconId, position)
VALUES (?, ?, ?, ?, ?, ?);

getMostUsedTags:
SELECT tag.* FROM tag
JOIN transaction_tag tt ON tag.id = tt.tagId
GROUP BY tag.id
ORDER BY COUNT(tt.transactionId) DESC
LIMIT :limit;


