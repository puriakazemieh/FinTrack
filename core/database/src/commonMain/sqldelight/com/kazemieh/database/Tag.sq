CREATE TABLE IF NOT EXISTS tag (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    colorId INTEGER NOT NULL DEFAULT 1,
    iconId INTEGER NOT NULL DEFAULT 1,
    position INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

addTag:
INSERT INTO tag(name, description, colorId, iconId, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertAllTag:
INSERT INTO tag(name, description, colorId, iconId, position, updatedAt, syncStatus)
VALUES ?;

observeTags:
SELECT * FROM tag WHERE syncStatus != 2 ORDER BY position ASC;

getTagById:
SELECT * FROM tag WHERE id = ? AND syncStatus != 2;

deleteTag:
UPDATE tag SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteTag:
DELETE FROM tag WHERE id = ?;

updateTag:
UPDATE tag
SET name = ?, description = ?, colorId = ?, iconId = ?, position = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

updateTagPosition:
UPDATE tag SET position = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullTag:
INSERT OR REPLACE INTO tag(id, name, description, colorId, iconId, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getMostUsedTags:
SELECT tag.* FROM tag
JOIN transaction_tag tt ON tag.id = tt.tagId
GROUP BY tag.id
ORDER BY COUNT(tt.transactionId) DESC
LIMIT :limit;

searchTags:
SELECT * FROM tag
WHERE name LIKE ('%' || :query || '%')
OR description LIKE ('%' || :query || '%')
ORDER BY position ASC;

getModifiedTags:
SELECT * FROM tag WHERE syncStatus = 1;

markTagAsSynced:
UPDATE tag SET syncStatus = 0 WHERE id = ?;


