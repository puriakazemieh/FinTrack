import com.kazemieh.common.model.AssetType;

CREATE TABLE IF NOT EXISTS rate_cache (
    code TEXT PRIMARY KEY NOT NULL,
    type TEXT AS AssetType NOT NULL,
    name TEXT NOT NULL,
    price INTEGER NOT NULL,
    lastUpdate INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS market_rate_history (
    code TEXT NOT NULL,
    price INTEGER NOT NULL,
    date INTEGER NOT NULL,
    PRIMARY KEY (code, date)
);

upsertRate:
INSERT OR REPLACE INTO rate_cache(code, type, name, price, lastUpdate)
VALUES (?, ?, ?, ?, ?);

observeRates:
SELECT * FROM rate_cache ORDER BY type ASC, code ASC;

getAllRates:
SELECT * FROM rate_cache ORDER BY type ASC, code ASC;

deleteAllRates:
DELETE FROM rate_cache;

deleteRatesByCodes:
DELETE FROM rate_cache WHERE code IN ?;

cacheRateHistory:
INSERT OR REPLACE INTO market_rate_history(code, price, date)
VALUES (?, ?, ?);

observeRateHistory:
SELECT * FROM market_rate_history
WHERE code = ?
ORDER BY date ASC
LIMIT 90;
