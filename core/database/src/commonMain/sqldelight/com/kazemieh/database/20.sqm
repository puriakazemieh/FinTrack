ALTER TABLE installment ADD COLUMN postAsTransaction INTEGER NOT NULL DEFAULT 1;

CREATE TABLE IF NOT EXISTS installment_tag (
    installmentId INTEGER NOT NULL,
    tagId INTEGER NOT NULL,
    PRIMARY KEY (installmentId, tagId),
    FOREIGN KEY (installmentId) REFERENCES installment(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId) REFERENCES tag(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_installment_tag_installment ON installment_tag(installmentId);
CREATE INDEX IF NOT EXISTS idx_installment_tag_tag ON installment_tag(tagId);

CREATE TABLE IF NOT EXISTS installment_person (
    installmentId INTEGER NOT NULL,
    personId INTEGER NOT NULL,
    PRIMARY KEY (installmentId, personId),
    FOREIGN KEY (installmentId) REFERENCES installment(id) ON DELETE CASCADE,
    FOREIGN KEY (personId) REFERENCES person(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_installment_person_installment ON installment_person(installmentId);
CREATE INDEX IF NOT EXISTS idx_installment_person_person ON installment_person(personId);
