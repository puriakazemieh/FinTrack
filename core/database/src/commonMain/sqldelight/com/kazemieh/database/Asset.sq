import com.kazemieh.common.model.AssetType;

CREATE TABLE IF NOT EXISTS asset (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    type TEXT AS AssetType NOT NULL,
    quantity REAL NOT NULL,
    purchasePrice INTEGER NOT NULL,
    currentPrice INTEGER,
    currency TEXT NOT NULL DEFAULT 'IRR',
    description TEXT,
    colorId INTEGER NOT NULL,
    iconId INTEGER NOT NULL,
    lastUpdate INTEGER,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS asset_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    assetId INTEGER NOT NULL,
    price INTEGER NOT NULL,
    date INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (assetId) REFERENCES asset(id) ON DELETE CASCADE
);

addAsset:
INSERT INTO asset(name, type, quantity, purchasePrice, currentPrice, currency, description, colorId, iconId, lastUpdate, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

observeAssets:
SELECT * FROM asset ORDER BY id DESC;

getAssetById:
SELECT * FROM asset WHERE id = ?;

updateAsset:
UPDATE asset
SET name = ?, type = ?, quantity = ?, purchasePrice = ?, currentPrice = ?, currency = ?, description = ?, colorId = ?, iconId = ?, lastUpdate = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

updateAssetPrice:
UPDATE asset SET currentPrice = ?, lastUpdate = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

deleteAsset:
DELETE FROM asset WHERE id = ?;

addAssetHistory:
INSERT INTO asset_history(assetId, price, date, updatedAt, syncStatus) VALUES (?, ?, ?, ?, ?);

observeAssetHistory:
SELECT * FROM asset_history WHERE assetId = ? ORDER BY date DESC;

getAllAssetHistory:
SELECT * FROM asset_history;

insertFullAssetHistory:
INSERT OR REPLACE INTO asset_history(id, assetId, price, date, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?);

getModifiedAssets:
SELECT * FROM asset WHERE syncStatus = 1;

markAssetAsSynced:
UPDATE asset SET syncStatus = 0 WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullAsset:
INSERT OR REPLACE INTO asset(id, name, type, quantity, purchasePrice, currentPrice, currency, description, colorId, iconId, lastUpdate, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedAssets:
SELECT * FROM asset WHERE syncStatus = 1;

markAssetAsSynced:
UPDATE asset SET syncStatus = 0 WHERE id = ?;
