CREATE TABLE IF NOT EXISTS person (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    position INTEGER NOT NULL DEFAULT 0
);

addPerson:
INSERT INTO person(name, description, position)
VALUES (?, ?, ?);

insertAllPerson:
INSERT INTO person(name, description, position)
VALUES ?;

observePersons:
SELECT * FROM person ORDER BY position ASC;

getPersonById:
SELECT * FROM person WHERE id = ?;

deletePerson:
DELETE FROM person WHERE id = ?;

updatePerson:
UPDATE person
SET name = ?, description = ?, position = ?
WHERE id = ?;

updatePersonPosition:
UPDATE person SET position = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullPerson:
INSERT OR REPLACE INTO person(id, name, description, position)
VALUES (?, ?, ?, ?);

getMostUsedPersons:
SELECT person.* FROM person
JOIN transaction_person tp ON person.id = tp.personId
GROUP BY person.id
ORDER BY COUNT(tp.transactionId) DESC
LIMIT :limit;


