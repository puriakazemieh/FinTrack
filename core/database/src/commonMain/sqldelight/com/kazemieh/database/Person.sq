CREATE TABLE IF NOT EXISTS person (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    position INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

addPerson:
INSERT INTO person(name, description, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?);

insertAllPerson:
INSERT INTO person(name, description, position, updatedAt, syncStatus)
VALUES ?;

observePersons:
SELECT * FROM person WHERE syncStatus != 2 ORDER BY position ASC;

getPersonById:
SELECT * FROM person WHERE id = ? AND syncStatus != 2;

deletePerson:
UPDATE person SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeletePerson:
DELETE FROM person WHERE id = ?;

updatePerson:
UPDATE person
SET name = ?, description = ?, position = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

updatePersonPosition:
UPDATE person SET position = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullPerson:
INSERT OR REPLACE INTO person(id, name, description, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?);

getMostUsedPersons:
SELECT person.* FROM person
JOIN transaction_person tp ON person.id = tp.personId
GROUP BY person.id
ORDER BY COUNT(tp.transactionId) DESC
LIMIT :limit;

searchPersons:
SELECT * FROM person
WHERE name LIKE ('%' || :query || '%')
OR description LIKE ('%' || :query || '%')
ORDER BY position ASC;

getModifiedPersons:
SELECT * FROM person WHERE syncStatus = 1;

markPersonAsSynced:
UPDATE person SET syncStatus = 0 WHERE id = ?;


