CREATE TABLE IF NOT EXISTS source (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    balance INTEGER NOT NULL DEFAULT 0,
    cardNumber TEXT,
    description TEXT,
    type INTEGER NOT NULL,
    colorId INTEGER NOT NULL DEFAULT 1,
    iconId INTEGER NOT NULL DEFAULT 1,
    shabaNumber TEXT,
    accountNumber TEXT,
    cvv2 TEXT,
    expirationMonth TEXT,
    expirationYear TEXT,
    branchCode TEXT,
    branchName TEXT,
    position INTEGER NOT NULL DEFAULT 0
);

addSource:
INSERT INTO source(name, balance, cardNumber, description, type, colorId, iconId, shabaNumber, accountNumber, cvv2, expirationMonth, expirationYear, branchCode, branchName, position)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

observeSources:
SELECT * FROM source ORDER BY position ASC;

observeSourceById:
SELECT * FROM source WHERE id = ?;

adjustBalance:
UPDATE source
SET balance = balance + ?
WHERE id = ?;

deleteSource:
DELETE FROM source WHERE id = ?;

updateSource:
UPDATE source
SET name = ?, balance = ?, cardNumber = ?, description = ?, type = ?, colorId = ?, iconId = ?, shabaNumber = ?, accountNumber = ?, cvv2 = ?, expirationMonth = ?, expirationYear = ?, branchCode = ?, branchName = ?, position = ?
WHERE id = ?;

updateSourcePosition:
UPDATE source SET position = ? WHERE id = ?;

getDefaultSource:
SELECT * FROM source ORDER BY id LIMIT 1;

lastInsertRowId:
SELECT last_insert_rowid();

getSourceById:
SELECT * FROM source WHERE id = ?;

insertFullSource:
INSERT OR REPLACE INTO source(id, name, balance, cardNumber, description, type, colorId, iconId, shabaNumber, accountNumber, cvv2, expirationMonth, expirationYear, branchCode, branchName, position)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getMostUsedSources:
SELECT * FROM source
WHERE id IN (SELECT sourceId FROM transactions) OR id IN (SELECT sourceEndId FROM transactions)
ORDER BY (
    (SELECT COUNT(*) FROM transactions WHERE sourceId = source.id) +
    (SELECT COUNT(*) FROM transactions WHERE sourceEndId = source.id)
) DESC
LIMIT :limit;

