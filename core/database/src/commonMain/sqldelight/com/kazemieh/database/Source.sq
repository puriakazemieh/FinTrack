CREATE TABLE IF NOT EXISTS source (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    balance INTEGER NOT NULL DEFAULT 0,
    cardNumber TEXT,
    description TEXT,
    type INTEGER NOT NULL,
    colorId INTEGER NOT NULL DEFAULT 1,
    iconId INTEGER NOT NULL DEFAULT 1,
    shabaNumber TEXT,
    accountNumber TEXT,
    cvv2 TEXT,
    expirationMonth TEXT,
    expirationYear TEXT,
    branchCode TEXT,
    branchName TEXT,
    position INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    currencyCode TEXT NOT NULL DEFAULT 'IRT'
);

addSource:
INSERT INTO source(name, balance, cardNumber, description, type, colorId, iconId, shabaNumber, accountNumber, cvv2, expirationMonth, expirationYear, branchCode, branchName, position, updatedAt, syncStatus, currencyCode)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

observeSources:
SELECT * FROM source WHERE syncStatus != 2 ORDER BY position ASC;

observeSourceById:
SELECT * FROM source WHERE id = ? AND syncStatus != 2;

adjustBalance:
UPDATE source
SET balance = balance + ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

deleteSource:
UPDATE source SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteSource:
DELETE FROM source WHERE id = ?;

updateSource:
UPDATE source
SET name = ?, balance = ?, cardNumber = ?, description = ?, type = ?, colorId = ?, iconId = ?, shabaNumber = ?, accountNumber = ?, cvv2 = ?, expirationMonth = ?, expirationYear = ?, branchCode = ?, branchName = ?, position = ?, updatedAt = ?, syncStatus = ?, currencyCode = ?
WHERE id = ?;

updateSourcePosition:
UPDATE source SET position = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

getDefaultSource:
SELECT * FROM source ORDER BY id LIMIT 1;

lastInsertRowId:
SELECT last_insert_rowid();

getSourceById:
SELECT * FROM source WHERE id = ?;

getSourceByIdentifier:
SELECT * FROM source
WHERE (cardNumber LIKE ('%' || :identifier) OR accountNumber LIKE ('%' || :identifier))
AND syncStatus != 2
LIMIT 1;

insertFullSource:
INSERT OR REPLACE INTO source(id, name, balance, cardNumber, description, type, colorId, iconId, shabaNumber, accountNumber, cvv2, expirationMonth, expirationYear, branchCode, branchName, position, updatedAt, syncStatus, currencyCode)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getMostUsedSources:
SELECT * FROM source
WHERE id IN (SELECT sourceId FROM transactions)
   OR id IN (SELECT sourceEndId FROM transactions)
   OR id IN (SELECT sourceId FROM debt)
   OR id IN (SELECT sourceId FROM installment)
ORDER BY (
    (SELECT COUNT(*) FROM transactions WHERE sourceId = source.id) +
    (SELECT COUNT(*) FROM transactions WHERE sourceEndId = source.id) +
    (SELECT COUNT(*) FROM debt WHERE sourceId = source.id) +
    (SELECT COUNT(*) FROM installment WHERE sourceId = source.id)
) DESC
LIMIT :limit;

searchSources:
SELECT * FROM source
WHERE name LIKE ('%' || :query || '%')
OR description LIKE ('%' || :query || '%')
OR cardNumber LIKE ('%' || :query || '%')
OR shabaNumber LIKE ('%' || :query || '%')
OR accountNumber LIKE ('%' || :query || '%')
ORDER BY position ASC;

getModifiedSources:
SELECT * FROM source WHERE syncStatus = 1;

markSourceAsSynced:
UPDATE source SET syncStatus = 0 WHERE id = ?;

batchConvertBalances:
UPDATE source SET balance = CAST(CAST(balance AS REAL) * :rate AS INTEGER), currencyCode = :newCode, updatedAt = :now, syncStatus = 1 WHERE currencyCode = :oldCode AND syncStatus != 2;
