-- Add sync columns to all major tables

ALTER TABLE transactions ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE transactions ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE category ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE category ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE source ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE source ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE asset ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE asset ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE budget ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE budget ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE check_table ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE check_table ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE debt ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE debt ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE fixed_expense ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE fixed_expense ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE installment ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE installment ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE tag ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE tag ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

ALTER TABLE person ADD COLUMN updatedAt INTEGER NOT NULL DEFAULT 0;
ALTER TABLE person ADD COLUMN syncStatus INTEGER NOT NULL DEFAULT 0;

-- New tables added recently that were missing from migration path
CREATE TABLE IF NOT EXISTS note_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT -1,
    isPinned INTEGER NOT NULL DEFAULT 0,
    isLocked INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS shopping_item_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    isChecked INTEGER NOT NULL DEFAULT 0,
    priority INTEGER NOT NULL DEFAULT 1,
    estimatedPrice REAL NOT NULL DEFAULT 0.0,
    reminderTime INTEGER,
    categoryId INTEGER,
    position INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (categoryId) REFERENCES category(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS sync_history (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    timestamp INTEGER NOT NULL,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    recordCount INTEGER NOT NULL,
    errorMessage TEXT
);

CREATE TABLE IF NOT EXISTS note_tag (
    noteId INTEGER NOT NULL,
    tagId INTEGER NOT NULL,
    PRIMARY KEY (noteId, tagId),
    FOREIGN KEY (noteId) REFERENCES note_table(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId) REFERENCES tag(id) ON DELETE CASCADE
);
