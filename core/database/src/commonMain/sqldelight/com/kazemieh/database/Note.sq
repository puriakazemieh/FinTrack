import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS note_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT -1,
    isPinned INTEGER AS Boolean NOT NULL DEFAULT 0,
    isLocked INTEGER AS Boolean NOT NULL DEFAULT 0,
    reminderTime INTEGER,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

observeNotes:
SELECT * FROM note_table WHERE syncStatus != 2 ORDER BY isPinned DESC, updatedAt DESC;

getNoteById:
SELECT * FROM note_table WHERE id = ? AND syncStatus != 2;

addNote:
INSERT INTO note_table(title, content, color, isPinned, isLocked, reminderTime, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE note_table
SET title = ?, content = ?, color = ?, isPinned = ?, isLocked = ?, reminderTime = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

deleteNote:
UPDATE note_table SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteNote:
DELETE FROM note_table WHERE id = ?;

updatePin:
UPDATE note_table SET isPinned = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

updateLock:
UPDATE note_table SET isLocked = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullNote:
INSERT OR REPLACE INTO note_table(id, title, content, color, isPinned, isLocked, reminderTime, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedNotes:
SELECT * FROM note_table WHERE syncStatus = 1;

markNoteAsSynced:
UPDATE note_table SET syncStatus = 0 WHERE id = ?;
