CREATE TABLE IF NOT EXISTS note (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT -1, -- 0xFFFFFFFF
    isPinned INTEGER AS Boolean NOT NULL DEFAULT 0,
    isLocked INTEGER AS Boolean NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

observeNotes:
SELECT * FROM note WHERE syncStatus != 2 ORDER BY isPinned DESC, updatedAt DESC;

getNoteById:
SELECT * FROM note WHERE id = ? AND syncStatus != 2;

addNote:
INSERT INTO note(title, content, color, isPinned, isLocked, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE note
SET title = ?, content = ?, color = ?, isPinned = ?, isLocked = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

deleteNote:
UPDATE note SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteNote:
DELETE FROM note WHERE id = ?;

updatePin:
UPDATE note SET isPinned = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

updateLock:
UPDATE note SET isLocked = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullNote:
INSERT OR REPLACE INTO note(id, title, content, color, isPinned, isLocked, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getModifiedNotes:
SELECT * FROM note WHERE syncStatus = 1;

markNoteAsSynced:
UPDATE note SET syncStatus = 0 WHERE id = ?;
