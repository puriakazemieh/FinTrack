CREATE TABLE IF NOT EXISTS note (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL,
    content TEXT NOT NULL,
    color INTEGER NOT NULL DEFAULT -1, -- 0xFFFFFFFF
    isPinned INTEGER AS Boolean NOT NULL DEFAULT 0,
    isLocked INTEGER AS Boolean NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0
);

observeNotes:
SELECT * FROM note ORDER BY isPinned DESC, updatedAt DESC;

getNoteById:
SELECT * FROM note WHERE id = ?;

addNote:
INSERT INTO note(title, content, color, isPinned, isLocked, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

updateNote:
UPDATE note
SET title = ?, content = ?, color = ?, isPinned = ?, isLocked = ?, updatedAt = ?
WHERE id = ?;

deleteNote:
DELETE FROM note WHERE id = ?;

updatePin:
UPDATE note SET isPinned = ? WHERE id = ?;

updateLock:
UPDATE note SET isLocked = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
