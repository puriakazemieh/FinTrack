CREATE TABLE IF NOT EXISTS goal (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    targetAmount INTEGER NOT NULL,
    savedAmount INTEGER NOT NULL DEFAULT 0,
    iconId INTEGER NOT NULL DEFAULT 1,
    colorId INTEGER NOT NULL DEFAULT 1,
    startDate INTEGER NOT NULL DEFAULT 0,
    endDate INTEGER,
    recurrence TEXT NOT NULL DEFAULT 'NONE',
    monthlyTarget INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

observeGoals:
SELECT * FROM goal WHERE syncStatus != 2;

getGoalById:
SELECT * FROM goal WHERE id = ? AND syncStatus != 2;

insertGoal:
INSERT INTO goal(name, targetAmount, savedAmount, iconId, colorId, startDate, endDate, recurrence, monthlyTarget, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateGoal:
UPDATE goal
SET name = ?, targetAmount = ?, savedAmount = ?, iconId = ?, colorId = ?, startDate = ?, endDate = ?, recurrence = ?, monthlyTarget = ?, updatedAt = ?, syncStatus = ?
WHERE id = ? AND syncStatus != 2;

deleteGoal:
UPDATE goal SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteGoal:
DELETE FROM goal WHERE id = ?;

insertFullGoal:
INSERT OR REPLACE INTO goal(id, name, targetAmount, savedAmount, iconId, colorId, startDate, endDate, recurrence, monthlyTarget, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedGoals:
SELECT * FROM goal WHERE syncStatus = 1;

markGoalAsSynced:
UPDATE goal SET syncStatus = 0 WHERE id = ?;
