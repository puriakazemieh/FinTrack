CREATE TABLE IF NOT EXISTS goal (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    targetAmount INTEGER NOT NULL,
    savedAmount INTEGER NOT NULL DEFAULT 0,
    iconId INTEGER NOT NULL DEFAULT 1,
    colorId INTEGER NOT NULL DEFAULT 1,
    startDate INTEGER NOT NULL DEFAULT 0,
    endDate INTEGER,
    recurrence TEXT NOT NULL DEFAULT 'NONE',
    monthlyTarget INTEGER NOT NULL DEFAULT 0,
    type TEXT NOT NULL DEFAULT 'SAVINGS',
    category TEXT NOT NULL DEFAULT 'SHORT_TERM',
    priority TEXT NOT NULL DEFAULT 'MEDIUM',
    description TEXT NOT NULL DEFAULT '',
    templateId INTEGER REFERENCES goal_template(id),
    basketId INTEGER REFERENCES goal_basket(id),
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS goal_template (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    systemType TEXT NOT NULL DEFAULT 'SAVINGS',
    iconId INTEGER NOT NULL DEFAULT 1,
    colorId INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE IF NOT EXISTS goal_basket (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    iconId INTEGER NOT NULL DEFAULT 1,
    colorId INTEGER NOT NULL DEFAULT 1,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0
);

-- Queries for goal_template
observeGoalTemplates:
SELECT * FROM goal_template WHERE syncStatus != 2;

insertGoalTemplate:
INSERT INTO goal_template(name, systemType, iconId, colorId, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?);

updateGoalTemplate:
UPDATE goal_template SET name = ?, systemType = ?, iconId = ?, colorId = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

deleteGoalTemplate:
UPDATE goal_template SET syncStatus = 2, updatedAt = ? WHERE id = ?;

-- Queries for goal_basket
observeGoalBaskets:
SELECT * FROM goal_basket WHERE syncStatus != 2;

insertGoalBasket:
INSERT INTO goal_basket(name, iconId, colorId, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?);

updateGoalBasket:
UPDATE goal_basket SET name = ?, iconId = ?, colorId = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

deleteGoalBasket:
UPDATE goal_basket SET syncStatus = 2, updatedAt = ? WHERE id = ?;

observeGoals:
SELECT * FROM goal WHERE syncStatus != 2;

getGoalById:
SELECT * FROM goal WHERE id = ? AND syncStatus != 2;

insertGoal:
INSERT INTO goal(name, targetAmount, savedAmount, iconId, colorId, startDate, endDate, recurrence, monthlyTarget, type, category, priority, description, templateId, basketId, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateGoal:
UPDATE goal
SET name = ?, targetAmount = ?, savedAmount = ?, iconId = ?, colorId = ?, startDate = ?, endDate = ?, recurrence = ?, monthlyTarget = ?, type = ?, category = ?, priority = ?, description = ?, templateId = ?, basketId = ?, updatedAt = ?, syncStatus = ?
WHERE id = ? AND syncStatus != 2;

deleteGoal:
UPDATE goal SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteGoal:
DELETE FROM goal WHERE id = ?;

insertFullGoal:
INSERT OR REPLACE INTO goal(id, name, targetAmount, savedAmount, iconId, colorId, startDate, endDate, recurrence, monthlyTarget, type, category, priority, description, templateId, basketId, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedGoals:
SELECT * FROM goal WHERE syncStatus = 1;

markGoalAsSynced:
UPDATE goal SET syncStatus = 0 WHERE id = ?;
