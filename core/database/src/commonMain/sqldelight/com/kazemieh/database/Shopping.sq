CREATE TABLE IF NOT EXISTS shopping_item (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    isChecked INTEGER AS Boolean NOT NULL DEFAULT 0,
    priority INTEGER NOT NULL DEFAULT 0,
    estimatedPrice REAL NOT NULL DEFAULT 0.0,
    reminderTime INTEGER,
    categoryId INTEGER,
    position INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (categoryId) REFERENCES category(id) ON DELETE SET NULL
);

observeShoppingItems:
SELECT * FROM shopping_item ORDER BY position ASC;

getShoppingItemById:
SELECT * FROM shopping_item WHERE id = ?;

addShoppingItem:
INSERT INTO shopping_item(name, isChecked, priority, estimatedPrice, reminderTime, categoryId, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateShoppingItem:
UPDATE shopping_item
SET name = ?, isChecked = ?, priority = ?, estimatedPrice = ?, reminderTime = ?, categoryId = ?, position = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

deleteShoppingItem:
DELETE FROM shopping_item WHERE id = ?;

updateShoppingItemPosition:
UPDATE shopping_item SET position = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullShoppingItem:
INSERT OR REPLACE INTO shopping_item(id, name, isChecked, priority, estimatedPrice, reminderTime, categoryId, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedShoppingItems:
SELECT * FROM shopping_item WHERE syncStatus = 1;

markShoppingItemAsSynced:
UPDATE shopping_item SET syncStatus = 0 WHERE id = ?;
