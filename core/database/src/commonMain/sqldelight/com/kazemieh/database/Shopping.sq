import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS shopping_item_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    name TEXT NOT NULL,
    isChecked INTEGER AS Boolean NOT NULL DEFAULT 0,
    priority INTEGER NOT NULL DEFAULT 1,
    estimatedPrice REAL NOT NULL DEFAULT 0.0,
    reminderTime INTEGER,
    categoryId INTEGER,
    note TEXT,
    position INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (categoryId) REFERENCES category(id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS shopping_item_tag (
    shoppingItemId INTEGER NOT NULL,
    tagId INTEGER NOT NULL,
    PRIMARY KEY (shoppingItemId, tagId),
    FOREIGN KEY (shoppingItemId) REFERENCES shopping_item_table(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId) REFERENCES tag(id) ON DELETE CASCADE
);

observeShoppingItems:
SELECT
    s.*,
    GROUP_CONCAT(tag.id) AS tag_ids,
    GROUP_CONCAT(tag.name) AS tag_names
FROM shopping_item_table s
LEFT JOIN shopping_item_tag sit ON s.id = sit.shoppingItemId
LEFT JOIN tag ON sit.tagId = tag.id
WHERE s.syncStatus != 2
GROUP BY s.id
ORDER BY s.position ASC;

getShoppingItemById:
SELECT
    s.*,
    GROUP_CONCAT(tag.id) AS tag_ids,
    GROUP_CONCAT(tag.name) AS tag_names
FROM shopping_item_table s
LEFT JOIN shopping_item_tag sit ON s.id = sit.shoppingItemId
LEFT JOIN tag ON sit.tagId = tag.id
WHERE s.id = ? AND s.syncStatus != 2
GROUP BY s.id;

addShoppingItem:
INSERT INTO shopping_item_table(name, isChecked, priority, estimatedPrice, reminderTime, categoryId, note, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertShoppingItemTagCrossRef:
INSERT OR REPLACE INTO shopping_item_tag(shoppingItemId, tagId)
VALUES (?, ?);

deleteShoppingItemTagCrossRefs:
DELETE FROM shopping_item_tag WHERE shoppingItemId = ?;

updateShoppingItem:
UPDATE shopping_item_table
SET name = ?, isChecked = ?, priority = ?, estimatedPrice = ?, reminderTime = ?, categoryId = ?, note = ?, position = ?, updatedAt = ?, syncStatus = ?
WHERE id = ?;

deleteShoppingItem:
UPDATE shopping_item_table SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteShoppingItem:
DELETE FROM shopping_item_table WHERE id = ?;

updateShoppingItemPosition:
UPDATE shopping_item_table SET position = ?, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullShoppingItem:
INSERT OR REPLACE INTO shopping_item_table(id, name, isChecked, priority, estimatedPrice, reminderTime, categoryId, note, position, updatedAt, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedShoppingItems:
SELECT * FROM shopping_item_table WHERE syncStatus = 1;

markShoppingItemAsSynced:
UPDATE shopping_item_table SET syncStatus = 0 WHERE id = ?;

getMostUsedShoppingTags:
SELECT tag.* FROM tag
JOIN shopping_item_tag sit ON tag.id = sit.tagId
GROUP BY tag.id
ORDER BY COUNT(sit.shoppingItemId) DESC
LIMIT :limit;

observeShoppingItemsFiltered:
SELECT
    s.*,
    GROUP_CONCAT(tag.id) AS tag_ids,
    GROUP_CONCAT(tag.name) AS tag_names
FROM shopping_item_table s
LEFT JOIN shopping_item_tag sit ON s.id = sit.shoppingItemId
LEFT JOIN tag ON sit.tagId = tag.id
WHERE s.syncStatus != 2
AND (:categoryIdsSize = 0 OR s.categoryId IN :categoryIds)
AND (:tagIdsSize = 0 OR EXISTS (
    SELECT 1 FROM shopping_item_tag WHERE shoppingItemId = s.id AND tagId IN :tagIds
))
GROUP BY s.id
ORDER BY s.position ASC;
