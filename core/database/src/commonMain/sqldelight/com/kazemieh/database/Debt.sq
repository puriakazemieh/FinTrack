CREATE TABLE IF NOT EXISTS debt (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    personId INTEGER NOT NULL,
    amount INTEGER NOT NULL,
    categoryId INTEGER,
    date INTEGER NOT NULL,
    dueDate INTEGER,
    sourceId INTEGER,
    description TEXT,
    type INTEGER NOT NULL,
    isSettled INTEGER NOT NULL DEFAULT 0,
    reminderEnabled INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    syncStatus INTEGER NOT NULL DEFAULT 0,
    currencyCode TEXT NOT NULL DEFAULT 'IRT',
    FOREIGN KEY (personId) REFERENCES person(id) ON DELETE CASCADE,
    FOREIGN KEY (sourceId) REFERENCES source(id) ON DELETE SET NULL,
    FOREIGN KEY (categoryId) REFERENCES category(id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_debt_person ON debt(personId);
CREATE INDEX IF NOT EXISTS idx_debt_source ON debt(sourceId);

insertDebt:
INSERT INTO debt(personId, amount, categoryId, date, dueDate, sourceId, description, type, isSettled, reminderEnabled, updatedAt, syncStatus, currencyCode)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDebt:
UPDATE debt
SET personId = ?, amount = ?, categoryId = ?, date = ?, dueDate = ?, sourceId = ?, description = ?, type = ?, isSettled = ?, reminderEnabled = ?, updatedAt = ?, syncStatus = ?, currencyCode = ?
WHERE id = ?;

deleteDebt:
UPDATE debt SET syncStatus = 2, updatedAt = ? WHERE id = ?;

physicallyDeleteDebt:
DELETE FROM debt WHERE id = ?;

getDebtById:
SELECT * FROM debt WHERE id = ? AND syncStatus != 2;

observeAllDebts:
SELECT
    d.*,
    p.name AS personName,
    p.description AS personDescription,
    s.name AS sourceName,
    s.colorId AS sourceColorId,
    s.iconId AS sourceIconId,
    c.name AS categoryName,
    c.colorId AS categoryColorId,
    c.iconId AS categoryIconId,
    GROUP_CONCAT(DISTINCT t.id) AS tagIds,
    GROUP_CONCAT(DISTINCT t.name) AS tagNames,
    GROUP_CONCAT(DISTINCT t.colorId) AS tagColorIds
FROM debt d
INNER JOIN person p ON d.personId = p.id
LEFT JOIN source s ON d.sourceId = s.id
LEFT JOIN category c ON d.categoryId = c.id
LEFT JOIN debt_tag dt ON d.id = dt.debtId
LEFT JOIN tag t ON dt.tagId = t.id
WHERE d.syncStatus != 2
GROUP BY d.id
ORDER BY d.isSettled ASC, d.date DESC;

observeDebtsByPerson:
SELECT
    d.*,
    p.name AS personName,
    p.description AS personDescription,
    s.name AS sourceName,
    s.colorId AS sourceColorId,
    s.iconId AS sourceIconId,
    c.name AS categoryName,
    c.colorId AS categoryColorId,
    c.iconId AS categoryIconId,
    GROUP_CONCAT(DISTINCT t.id) AS tagIds,
    GROUP_CONCAT(DISTINCT t.name) AS tagNames,
    GROUP_CONCAT(DISTINCT t.colorId) AS tagColorIds
FROM debt d
INNER JOIN person p ON d.personId = p.id
LEFT JOIN source s ON d.sourceId = s.id
LEFT JOIN category c ON d.categoryId = c.id
LEFT JOIN debt_tag dt ON d.id = dt.debtId
LEFT JOIN tag t ON dt.tagId = t.id
WHERE d.personId = ? AND d.syncStatus != 2
GROUP BY d.id
ORDER BY d.date DESC;

settleDebt:
UPDATE debt SET isSettled = 1, updatedAt = ?, syncStatus = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertFullDebt:
INSERT OR REPLACE INTO debt(id, personId, amount, categoryId, date, dueDate, sourceId, description, type, isSettled, reminderEnabled, updatedAt, syncStatus, currencyCode)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getModifiedDebts:
SELECT * FROM debt WHERE syncStatus = 1;

markDebtAsSynced:
UPDATE debt SET syncStatus = 0 WHERE id = ?;

batchConvertAmounts:
UPDATE debt SET amount = CAST(CAST(amount AS REAL) * :rate AS INTEGER), currencyCode = :newCode, updatedAt = :now, syncStatus = 1 WHERE currencyCode = :oldCode AND syncStatus != 2;
