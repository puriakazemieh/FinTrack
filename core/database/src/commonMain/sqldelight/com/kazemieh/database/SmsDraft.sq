CREATE TABLE IF NOT EXISTS sms_draft (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    sender TEXT NOT NULL,
    body TEXT NOT NULL,
    amount INTEGER NOT NULL,
    bankName TEXT NOT NULL,
    type INTEGER NOT NULL,
    sourceId INTEGER,
    sourceIdentifier TEXT,
    timeStamp INTEGER NOT NULL,
    date TEXT NOT NULL,
    categoryId INTEGER,
    confidence INTEGER NOT NULL DEFAULT 100,
    isUsed INTEGER NOT NULL DEFAULT 0,
    ignoredAt INTEGER,
    FOREIGN KEY (sourceId) REFERENCES source(id) ON DELETE SET NULL,
    FOREIGN KEY (categoryId) REFERENCES category(id) ON DELETE SET NULL
);

insertSmsDraft:
INSERT INTO sms_draft(sender, body, amount, bankName, type, sourceId, sourceIdentifier, timeStamp, date, categoryId, confidence, isUsed, ignoredAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSmsDraft:
UPDATE sms_draft
SET sender = ?, body = ?, amount = ?, bankName = ?, type = ?, sourceId = ?, sourceIdentifier = ?, timeStamp = ?, date = ?, categoryId = ?, confidence = ?, isUsed = ?
WHERE id = ? AND isUsed = 0;

observeUnusedSmsDrafts:
SELECT * FROM sms_draft WHERE isUsed = 0 ORDER BY timeStamp DESC;

markSmsDraftAsUsed:
UPDATE sms_draft SET isUsed = 1 WHERE id = ?;

deleteSmsDraft:
DELETE FROM sms_draft WHERE id = ?;

deleteUnusedSmsDrafts:
DELETE FROM sms_draft WHERE isUsed = 0;

getUnusedSmsDraftIds:
SELECT id FROM sms_draft WHERE isUsed = 0 AND id IN ? ORDER BY id;

deleteUnusedSmsDraftsByIds:
DELETE FROM sms_draft WHERE isUsed = 0 AND id IN ?;

getSmsDraftById:
SELECT * FROM sms_draft WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

ignoreUnusedSmsDraft:
UPDATE sms_draft SET ignoredAt = coalesce(ignoredAt, :ignoredAt)
WHERE id = :id AND isUsed = 0;

observeIgnoredSmsDrafts:
SELECT * FROM sms_draft WHERE isUsed = 0 AND ignoredAt > :cutoff ORDER BY ignoredAt DESC, id DESC;

deleteExpiredIgnoredSmsDrafts:
DELETE FROM sms_draft WHERE isUsed = 0 AND ignoredAt <= :cutoff;
